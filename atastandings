def get_country(state):
    """Return the appropriate country for a given state"""
    # https://atamartialarts.com/Scripts/state-standing.bundle.js
    # Set the country code appropriately based on the state.
    # Experimentally, it looks like "country=$COUNTRY" is NOT required,
    # but we'll pass it in anyway.
    if state in CA_PROVINCES:
        country = "CA"
    else:
        country = "US"
    return country


def upper_case(lst):
    """Convert all elements in the array to uppercase"""
    if lst:
        for i, l in enumerate(lst):
            lst[i] = l.upper()


def add_codes(codes, seen, items):
    """Append items to codes while preserving order and deduplicating by code key."""
    for code in items:
        key = code[0]  # code=XXXX
        if key not in seen:
            seen.add(key)
            codes.append(code)


def select_codes(args, allcodes_provider):
    """
    Build division code list from CLI selectors.

    allcodes_provider must be a zero-argument callable returning the same
    structure as get_codes(): [["code=...", "Division Name"], ...]

    The output from args.girls, args.boys, args.women, args.men are ORed together
        If args.andopt is specified, then ANDed with args.rank
        Else, args.rank is ORed with the other selectors.
    """
    found_codes = False
    codes = []
    seen = set()
    allcodes = None

    if args.division_code:
        found_codes = True
        add_codes(codes, seen, [[f"code={code}", ""] for code in args.division_code])

    def get_allcodes():
        nonlocal allcodes
        if allcodes is None:
            allcodes = allcodes_provider()
            if args.verbose > 1:
                print(f"allcodes={allcodes}", file=sys.stderr, flush=True)
        return allcodes

    gender_selected = args.girls or args.boys or args.women or args.men

    def gender_match(code):
        gcode = code[0].lower()[5]
        return (
            (args.girls and gcode == "g")
            or (args.boys and gcode == "b")
            or (args.women and gcode == "w")
            or (args.men and gcode == "m")
        )

    # Keep current rank behavior: substring match in the extracted rank area.
    def rank_match(code):
        return any(rank in code[0][6:-1] for rank in args.rank)

    if args.andopt:
        # main() validates that --and only appears with both a gender selector and --rank.
        if gender_selected and args.rank:
            found_codes = True
            add_codes(codes, seen, [code for code in get_allcodes() if gender_match(code) and rank_match(code)])
    else:
        if gender_selected:
            found_codes = True
            add_codes(codes, seen, [code for code in get_allcodes() if gender_match(code)])

        if args.rank:
            found_codes = True
            add_codes(codes, seen, [code for code in get_allcodes() if rank_match(code)])

    if not found_codes:
        add_codes(codes, seen, get_allcodes())

    if args.verbose > 1:
        print(f"codes={codes}", file=sys.stderr, flush=True)

    return codes


def print_worlds(args):
    """Print the worlds standings"""
    codes = select_codes(args, lambda: get_codes(args, WORLDBASE, STANDINGS_WORLDS))

    if args.list_division_codes:
