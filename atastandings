def get_next_random_word():
    """
    Return the next random word from RANDOM_WORDS.
    Push the word onto USED_WORDS.
    If none are left in RANDOM_WORDS, reassign RANDOM_WORDS and reshuffle.
    """
    # pylint: disable=global-statement
    global RANDOM_WORDS, USED_WORDS
    if not RANDOM_WORDS:
        RANDOM_WORDS = USED_WORDS
        USED_WORDS = []
        random.shuffle(RANDOM_WORDS)
    wd = RANDOM_WORDS.pop(0)
    USED_WORDS.append(wd)
    return wd


def get_random_word(nm):
    """
    Given a name, return a random name to use in its place.
    Do this by grabbing two random words at a time from the front of the list.
    """
    while True:
        repl_name = get_next_random_word().capitalize() + get_next_random_word()
        if repl_name not in RANDOM_NAME_MAP:
            RANDOM_NAME_MAP[nm] = repl_name
            return repl_name


def get_random_name(args, nm):
    """
    Given a name, and randomizing is on, return a random name to use in its place.
    """
    if not args.randomize_names:
        return nm

    if not RANDOM_WORDS and not USED_WORDS:
        with open(args.randomize_names) as fp:
            for l in fp:
                RANDOM_WORDS.append(l.strip().lower())
        random.shuffle(RANDOM_WORDS)
        for nms in NAME_SUFFIXES:
            RANDOM_NAME_MAP[nms] = nms
        for nmp in NAME_PREFIXES:
            RANDOM_NAME_MAP[nmp] = nmp

    newname = []
    for l in nm.lower().split():
        newname.append(get_random_word(l))
    return " ".join(newname)


def get_cache_dir():
    """Determine the directory where to store a cache of the web files"""
    for name in ["TEMP", "TMP", "TMPDIR", "TEMPDIR"]:
        dirname = os.environ.get(name)
        if dirname and os.path.isdir(dirname):
            return dirname
    return "/tmp"


def strip_html(l):
    """strip out all html <tags>"""
    l = re.sub("<[^>]*>", "", l)
    l = re.sub(r"\s+", " ", l)
    return l


def cache_stat(cachename):
    """Search the cachename for .gz, .bz2, "" versions. Return cachename with suffix plus stat info."""
    for suffix in ZIP_SUFFIXES:
        try:
            st = os.stat(cachename + suffix)
            # print(f"found {cachename + suffix}")
            return (cachename + suffix, st)
        except FileNotFoundError:
            pass
    return (cachename, None)


def open_cache_read(cachename, mode="rt"):
    """Open the file, with the appropriate gzip/bzip2/"" open() function."""
    if cachename.endswith(".gz"):
        return gzip.open(cachename, mode)
    if cachename.endswith(".bz2"):
        return bz2.open(cachename, mode)
    return open(cachename, mode)


def open_cache_write(args, cachename, mode="wt"):
    """Open the file, with the appropriate gzip/bzip2/"" open() function."""
    if args.bzip2_cache:
        return bz2.open(cachename, mode)
    if args.gzip_cache:
        return gzip.open(cachename, mode)
    return open(cachename, mode)


def decode_url(cache_name):
    """
    From a cache_name, atastandings.<<encoded-url>>,
    recreate the original URL.
    Account for gz/bz2 suffixes
    """
    if cache_name.startswith(CACHE_URL_PREFIX):
        cache_name = cache_name[len(CACHE_URL_PREFIX) :]
    for suffix in ZIP_SUFFIXES:
        if suffix and cache_name.endswith(suffix):
            cache_name = cache_name[: -len(suffix)]
            break

    ret = []
    i = 0
    while i < len(cache_name):
        if cache_name[i] == "_":
            if cache_name[i + 1] == "_":
                ret.append("_")
                i += 2
            else:
                c = cache_name[i + 1 : i + 3]
                # print(f"c={c}")
                ic = int(c, 16)
                # print(f"ic={ic}, chr(ic)={chr(ic)}")
                ret.append(chr(ic))
                i += 3
        else:
            ret.append(cache_name[i])
            i += 1
    return ATABASE + "".join(ret)


def get_cache_name(url):
    """
    From a url, generate an encoded version.
    Trim off the ATABASE.
    Use encoding similar to url %-encoding on all special characters,
    but with '_' instead of '%'.
    """
    sig_url = url[len(ATABASE) :]
    ret = []

    for c in sig_url:
        if c == "_":
            ret.append("__")
        elif c not in "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            ret.append("_" + hex(ord(c)).replace("0x", ""))
        else:
            ret.append(c)

    return "".join(ret)


def get_cache_date_directory_glob(date_format):
    """Return a date-directory glob fragment for the selected format."""
    if not date_format:
        return ""
    if date_format == "yy-mm-dd":
        return "[0-9][0-9]-[0-9][0-9]-[0-9][0-9]"
    if date_format == "yyyy-mm-dd":
        return "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]"
    return ""


def standings_date_to_cache_dir(args, standings_date):
    """Convert mm/dd/yyyy standings-date text to configured cache-dir date format."""
    if not args.add_date_to_cache_directory:
        return ""

    if not standings_date:
        return ""

    # This is intentionally a shape-only parse. If upstream emits an impossible
    # calendar date (for example 13/40/2026), we currently preserve it as a
    # directory token rather than rejecting it.
    m = re.match(r"^\s*([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})\s*$", standings_date)
    if not m:
        return ""

    month, day, year = m.groups()
    if args.add_date_to_cache_directory == "yy-mm-dd":
        year = year[-2:]
    return f"{year}-{int(month):02d}-{int(day):02d}"


def get_effective_cache_directory(args):
    """Return cache directory including an optional date suffix."""
    if args.add_date_to_cache_directory and args.current_standings_date_dir:
        return os.path.join(args.cache_directory, args.current_standings_date_dir)
    return args.cache_directory


def get_cache_name_base(args, url):
    """Return full cache-file basename for a URL in the effective cache directory."""
    urlname = get_cache_name(url)
    return f"{get_effective_cache_directory(args)}/{CACHE_URL_PREFIX}{urlname}"


def initialize_current_standings_date_dir(args):
    """Initialize current standings date directory from existing date-format subdirectories."""
    args.current_standings_date_dir = ""
    if not args.add_date_to_cache_directory:
        return

    date_glob = get_cache_date_directory_glob(args.add_date_to_cache_directory)
    g = f"{args.cache_directory}/{date_glob}"
    date_dir = ""
    for dirname in glob.glob(g):
        if os.path.isdir(dirname):
            bn = os.path.basename(dirname)
            date_dir = max(date_dir, bn)

    if date_dir:
        args.current_standings_date_dir = date_dir
        verbose(args, f"cache-date-dir: initialized to {args.current_standings_date_dir}")
    else:
        verbose(
            args,
            f"cache-date-dir: no {args.add_date_to_cache_directory} directories found; using base cache directory",
        )


def get_http_client(args):
    """Return a shared HTTP client with cookie/session state."""
    if args.http_client is None:
        args.http_client = httpx.Client(
            follow_redirects=True,
            cookies=args.cookie_jar,
        )
    return args.http_client


def cookiejar_from_mapping(mapping):
    """Create a CookieJar from a simple name/value mapping."""
    cookie_jar = CookieJar()
    for name, value in mapping.items():
        cookie_jar.set_cookie(
            Cookie(
                version=0,
                name=name,
                value=value,
                port=None,
                port_specified=False,
                domain="atamartialarts.com",
                domain_specified=False,
                domain_initial_dot=False,
                path="/",
                path_specified=True,
                secure=True,
                expires=None,
                discard=True,
                comment=None,
                comment_url=None,
                rest={},
                rfc2109=False,
            )
        )
    return cookie_jar


def deserialize_cookie_jar(cookie_value):
    """Deserialize cookie storage from keyring to a CookieJar."""
    if not cookie_value:
        return None

    try:
        payload = json.loads(cookie_value)
    except json.JSONDecodeError:
        payload = None

    if isinstance(payload, dict) and payload.get("format") == COOKIE_KEYRING_FORMAT:
        cookie_jar = CookieJar()
        for item in payload.get("cookies", []):
            cookie_jar.set_cookie(
                Cookie(
                    version=item.get("version"),
                    name=item["name"],
                    value=item.get("value"),
                    port=item.get("port"),
                    port_specified=item.get("port_specified", False),
                    domain=item["domain"],
                    domain_specified=item.get("domain_specified", False),
                    domain_initial_dot=item.get("domain_initial_dot", False),
                    path=item["path"],
                    path_specified=item.get("path_specified", True),
                    secure=item.get("secure", False),
                    expires=item.get("expires"),
                    discard=item.get("discard", True),
                    comment=item.get("comment"),
                    comment_url=item.get("comment_url"),
                    rest=item.get("rest", {}),
                    rfc2109=item.get("rfc2109", False),
                )
            )
        return cookie_jar

    # Backward compatibility with previous versions that stored JSON mappings.
    if isinstance(payload, dict):
        return cookiejar_from_mapping(payload)

    # Backward compatibility with previous versions that stored cookie header text.
    parsed = SimpleCookie()
    parsed.load(cookie_value)
    if parsed:
        return cookiejar_from_mapping({name: morsel.value for name, morsel in parsed.items()})

    return None


def serialize_cookie_jar(cookie_jar):
    """Serialize a CookieJar to a full-fidelity JSON string for keyring."""
    cookies = []
    for cookie in cookie_jar:
        cookies.append(
            {
                "version": cookie.version,
                "name": cookie.name,
                "value": cookie.value,
                "port": cookie.port,
                "port_specified": cookie.port_specified,
                "domain": cookie.domain,
                "domain_specified": cookie.domain_specified,
                "domain_initial_dot": cookie.domain_initial_dot,
                "path": cookie.path,
                "path_specified": cookie.path_specified,
                "secure": cookie.secure,
                "expires": cookie.expires,
                "discard": cookie.discard,
                "comment": cookie.comment,
                "comment_url": cookie.comment_url,
                "rest": getattr(cookie, "_rest", {}),
                "rfc2109": cookie.rfc2109,
            }
        )
    return json.dumps({"format": COOKIE_KEYRING_FORMAT, "cookies": cookies})


def initialize_cookie_jar(args):
    """Initialize args.cookie_jar once at startup from file or keyring."""
    if args.cookie_file is not None:
        args.cookie_jar = MozillaCookieJar(args.cookie_file)
        try:
            args.cookie_jar.load(ignore_discard=True, ignore_expires=True)
        except FileNotFoundError:
            print("Cookie file not found. Starting with a fresh session.", file=sys.stderr, flush=True)
        return

    if args.cookie_key is not None:
        cookie_value = keyring.get_password(args.cookie_key, args.username)
        args.cookie_jar = deserialize_cookie_jar(cookie_value)


def resolve_auth_password(args):
    """Resolve auth password from CLI or keyring.

    Returns: (password, source, reason)
      password: resolved password or None
      source: human-readable source string or None
      reason: None on success, otherwise a reason code
    """
    if not args.username:
        return (None, None, "missing-username")

    if args.password_key:
        verbose(args, f"auth: looking up password in keyring service '{args.password_key}' for user '{args.username}'")
        try:
            password = keyring.get_password(args.password_key, args.username)
        except Exception as e:  # pragma: no cover
            verbose(args, f"auth: keyring password lookup failed: {type(e).__name__}: {e}")
            return (None, None, "password-key-error")
        if not password:
            verbose(args, f"auth: keyring has no password for service '{args.password_key}' and user '{args.username}'")
            return (None, None, "password-key-not-found")
        return (password, f"keyring:{args.password_key}", None)

    if args.password:
        verbose(args, "auth: using password from --password / ATASTANDINGS_PASSWORD")
        return (args.password, "cli-or-env", None)

    return (None, None, "missing-password")


def auth_failure_message(args, reason):  # pylint: disable=too-many-return-statements
    """Return a user-facing authentication failure message for a reason code."""
    if reason == "missing-username":
        return "Authentication failed: missing --username (or username config value)."
    if reason == "missing-password":
        return (
            "Authentication failed: no password source configured. "
            "Set --password or --password-key (or ATASTANDINGS_PASSWORD)."
        )
    if reason == "password-key-not-found":
        return (
            "Authentication failed: keyring password was not found for "
            f"service '{args.password_key}' and user '{args.username}'."
        )
    if reason == "password-key-error":
        return "Authentication failed: keyring password lookup failed."
    if reason == "login-page-fetch-failed":
        return "Authentication failed: could not fetch the login page."
    if reason == "missing-verification-token":
        return "Authentication failed: login page did not provide a verification token."
    if reason == "login-post-failed":
        return "Authentication failed: login POST request failed."
    if reason == "missing-identity-cookie":
        return "Authentication failed: login completed but no identity session cookie was set."
    if reason == "still-login-page":
        return "Authentication failed: login response still appears to be the login page."
    return "Authentication failed. Check your ATA credentials and login settings."


def is_login_page(text):
    """Return True if the response body looks like the login form page."""
    if not text:
        return False
    return "loginModel.Username" in text and "__RequestVerificationToken" in text


def get_hidden_input_values(text):
    """Extract hidden input name/value pairs from HTML text."""
    values = {}
    for name, value in re.findall(r'<input[^>]*name="([^"]+)"[^>]*value="([^"]*)"', text):
        values[name] = html.unescape(value)
    return values


def request_with_retries(args, method, url, **kwargs):
    """Issue an HTTP request with retry behavior matching existing get_url semantics."""
    client = get_http_client(args)
    r = None
    errmsg = None

    verbose(args, f"http: starting {method.upper()} {url}")
    for i in range(args.connection_count):
        errmsg = None
        try:
            extra_verbose(args, 2, f"http: attempt {i+1}/{args.connection_count} {method.upper()} {url}")
            r = client.request(method, url, **kwargs)
        except httpx.ReadTimeout:
            errmsg = f"Timeout for {url}"
        except httpx.ConnectError:
            errmsg = f"ConnectError for {url}"
        except httpx.ReadError:
            errmsg = f"ReadError for {url}"
        except httpx.RequestError as e:
            errmsg = f"HTTP Exception for {e.request.url} - {e}"
        except httpx.HTTPError as e:
            errmsg = f"HTTP Exception for {e.request.url} - {e}"
        except Exception as e:
            errmsg = f"Other conn error for {url}: {type(e)}: {e}"

        if r:
            extra_verbose(args, 2, f"http: response status={r.status_code} url={r.url}")
            return r

        verbose(args, f"http: attempt {i+1} failed: {errmsg}")
        print(f"#{i+1}: {errmsg}", file=sys.stderr, flush=True)
        time.sleep(args.retry_interval)

    verbose(args, f"http: exhausted retries for {method.upper()} {url}")
    return None


def authenticate(args):  # pylint: disable=too-many-return-statements
    """Authenticate to ATA and keep session cookies in the shared HTTP client.

    Returns: (success: bool, reason: str)
    """
    password, source, reason = resolve_auth_password(args)
    if reason:
        verbose(args, f"auth: cannot start authentication: {reason}")
        return (False, reason)

    verbose(args, f"auth: begin user={args.username} password_source={source}")
    verbose(args, f"auth: GET {LOGIN_URL}")
    login_page = request_with_retries(args, "GET", LOGIN_URL)
    if login_page is None:
        verbose(args, "auth: failed to fetch login page")
        return (False, "login-page-fetch-failed")

    hidden = get_hidden_input_values(login_page.text)
    token = hidden.get("__RequestVerificationToken")
    if not token:
        verbose(args, "auth: login page missing __RequestVerificationToken")
        return (False, "missing-verification-token")

    verbose(args, f"auth: extracted token length={len(token)}")

    payload = {
        "loginModel.Username": args.username,
        "loginModel.Password": password,
        "loginModel.RedirectUrl": "",
        "loginModel.RememberMe": "true",
        "__RequestVerificationToken": token,
    }
    if "ufprt" in hidden:
        payload["ufprt"] = hidden["ufprt"]
        verbose(args, "auth: included ufprt token")

    headers = {
        "Origin": "https://atamartialarts.com",
        "Referer": LOGIN_URL,
    }

    verbose(args, f"auth: POST {LOGIN_POST_URL}")
    login_post = request_with_retries(args, "POST", LOGIN_POST_URL, data=payload, headers=headers)
    if login_post is None:
        verbose(args, "auth: login POST failed")
        return (False, "login-post-failed")

    verbose(args, f"auth: login POST status={login_post.status_code} final_url={login_post.url}")

    # Confirm we are no longer on a login page and that identity cookie is present.
    client = get_http_client(args)
    has_identity_cookie = (
        ".AspNetCore.Identity.Application" in client.cookies or "AspNetCore.Identity.Application" in client.cookies
    )
    still_login_page = is_login_page(login_post.text)
    verbose(args, f"auth: identity_cookie={has_identity_cookie} still_login_page={still_login_page}")
    if has_identity_cookie and not still_login_page:
        verbose(args, "auth: success")
        return (True, "success")

    if still_login_page:
        verbose(args, "auth: failed validation after login POST (still on login page)")
        return (False, "still-login-page")
    verbose(args, "auth: failed validation after login POST (identity cookie not set)")
    return (False, "missing-identity-cookie")


def extra_verbose(args, level, msg):
